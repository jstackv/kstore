# Server
PORT=5000
NODE_ENV=development
# Exact origin of the deployed frontend, no trailing slash - required for
# cookies to work cross-origin in production (e.g. https://kstore.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kstore

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# First admin account, created once via POST /api/admin/bootstrap (only works
# while the database has zero users - see README "Creating the first admin").
# All three are optional; shown here are the defaults used if you omit them.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@kstore.app
ADMIN_PASSWORD=Admin@KStore2026!
